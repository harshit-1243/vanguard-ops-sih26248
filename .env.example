# ---- Server ----
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# Sim clock rate in ticks per wall-second at speed x1 (each tick = 1000 ms sim time)
TICK_HZ=1

# ---- Persistence ----
# Leave empty to use the in-memory event store (zero-setup local dev / tests).
# Docker / production: postgres connection string.
# DATABASE_URL=postgresql://vanguard:vanguard@localhost:5432/vanguard
DATABASE_URL=

# Seed a finished demo exercise on boot when the DB has no sessions (true/false)
SEED_DEMO_ON_EMPTY=false

# ---- Optional AI layer (Smart Automation) ----
# none | ollama | anthropic   (none = deterministic templates; app is fully functional)
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
